<?xml version="1.0" encoding="utf-8"?>
<!--
  Este nuget.config é usado pelos microsserviços para consumir o pacote FCGames.IntegrationEvents
  do GitHub Packages.

  Como usar em cada serviço:
  1. Copiar este arquivo para a raiz do repo do serviço
  2. Substituir TOKEN pelo seu PAT (Personal Access Token) com scope read:packages
     OU usar a variável de ambiente NUGET_AUTH_TOKEN:
     dotnet restore -e NUGET_AUTH_TOKEN=<seu-token>

  Em CI/CD (GitHub Actions), usar:
    env:
      NUGET_AUTH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
-->
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="FCGames-GitHub" value="https://nuget.pkg.github.com/FIAP-POS-TECH-TEAM-10/index.json" />
  </packageSources>
  <packageSourceCredentials>
    <FCGames-GitHub>
      <add key="Username" value="FIAP-POS-TECH-TEAM-10" />
      <add key="ClearTextPassword" value="%NUGET_AUTH_TOKEN%" />
    </FCGames-GitHub>
  </packageSourceCredentials>
</configuration>
