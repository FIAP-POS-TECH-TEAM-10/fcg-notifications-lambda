{
  "profiles": {
    "AWS Lambda Test Tool": {
      "executablePath": "%USERPROFILE%\\.dotnet\\tools\\dotnet-lambda-test-tool-10.0.exe",
      "commandLineArgs": "--port 5050",
      "workingDirectory": "$(ProjectDir)bin\\$(Configuration)\\net10.0",
      "launchBrowser": true,
      "launchUrl": "http://localhost:5050",
      "environmentVariables": {
        "AWS_REGION": "sa-east-1",
        "ENVIRONMENT": "Development"
      }
    }
  }
}